# Copy this file to `.env.local` and fill in both values from your Supabase
# project (Project Settings > API Keys / Data API).

# Looks like https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE key (older projects call it the "anon public" key).
# Never the secret / service_role key: this value is visible in the browser.
NEXT_PUBLIC_SUPABASE_KEY=
